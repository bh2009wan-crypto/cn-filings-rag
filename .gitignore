# ===== 密钥与日志（绝不入库）=====
.env
logs/
# 注意：写 "outputs/" 会让 git 不再进入该目录，里面的文件就**无法**用 ! 重新包含；
# 所以这里用 "outputs/*" 再逐类放行（截图与结论是交付物，必须入库）
outputs/*
!outputs/*.md
!outputs/*.png
!outputs/eval/
outputs/eval/*
!outputs/eval/*.csv
!outputs/eval/*.md

# ===== 财报原件与派生的大文件（不入库；README 里写明怎么重新生成）=====
data/pdf/
data/text/
data/index/
models/

# ===== 保留的：清单、统计、可入库的问答数据、结论 =====
!config/companies.json
!config/reports_b.json
!data/chunks/chunk_stats.json
!data/sft/git/*.jsonl
!data/sft/gen_log.json
!data/sft/qc_report.json
!data/sft/split_manifest.json
!outputs/*.md
!outputs/*.png
!outputs/eval/*.csv
!outputs/eval/*.md

# SFT 完整版（含 chunk_text=整页原文）不入库；入库的是 data/sft/git/ 的去原文版本
data/sft/*.jsonl

# ===== Python =====
__pycache__/
*.pyc
.DS_Store
.pytest_cache/

# 切块后的全文（= 财报原文的派生文本，不入库；用 04_chunk.py 重新生成）
data/chunks/chunks_*.jsonl


