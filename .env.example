# ============================================================
# 复制成 .env 再填自己的值：  cp .env.example .env && chmod 600 .env
# .env 里放密钥，永远不要写进代码、不要截图、不要上传。
# ============================================================

# --- 大模型（本作业用 DeepSeek 的 OpenAI 兼容端点）---
# 便宜模型：A 的作答、B 的造数据/质检/换问法都用它（对齐课件"deepseek-flash/关掉思考模式"）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-在这里填你的key
DEEPSEEK_MODEL=deepseek-flash

# --- 兼容 daily-report 的键名（二选一即可，程序会自动回退）---
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_AUTH_TOKEN=sk-在这里填你的key
# ANTHROPIC_MODEL=deepseek-flash

# --- 跑到 Colab 上要用的（本机不用）---
# HF_ENDPOINT=https://hf-mirror.com
